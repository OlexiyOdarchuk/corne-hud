[Desktop Entry]
Type=Application
Name=Corne HUD
Name[uk]=Corne — екрани
GenericName=Keyboard OLED Screens
GenericName[uk]=OLED-екрани клавіатури
Comment=OLED screen modes, pictures and animations for the Corne keyboard
Comment[uk]=Режими OLED-екранів, картинки й анімації
Exec=corne-hud gui
Icon=io.github.OlexiyOdarchuk.CorneHud
Terminal=false
StartupNotify=true
StartupWMClass=io.github.OlexiyOdarchuk.CorneHud
Categories=Utility;Settings;HardwareSettings;
Keywords=corne;keyboard;oled;qmk;vial;screen;hid;
Keywords[uk]=corne;клавіатура;екран;oled;qmk;vial;
Actions=draw;

[Desktop Action draw]
Name=Draw
Name[uk]=Малювання
Exec=corne-hud draw
